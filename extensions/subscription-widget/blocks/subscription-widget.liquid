{%- if product.selling_plan_groups.size > 0 -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign widget_id = 'subscription-widget-' | append: block.id -%}
  {%- assign radio_name = 'selling-plan-selection-' | append: block.id -%}

  <div
    id="{{ widget_id }}"
    class="custom-subscription-widget"
    data-product-id="{{ product.id }}"
    data-form-id="{{ block.settings.form_id | escape }}"
    style="
      width: 100%;
      margin: 1.5rem 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    "
  >
    {%- if block.settings.heading != blank -%}
      <div style="margin-bottom: 1rem;">
        <span
          style="
            display: block;
            color: #111827;
            font-size: 1.6rem;
            font-weight: 700;
            line-height: 1.3;
          "
        >
          {{ block.settings.heading }}
        </span>
      </div>
    {%- endif -%}

    <div
      class="sw-options"
      style="
        display: flex;
        flex-direction: column;
        gap: 1rem;
      "
    >
      {%- unless product.requires_selling_plan -%}
        <label
          class="sw-option sw-active"
          data-selling-plan-id=""
          data-price="{{ current_variant.price | money | escape }}"
          style="
            display: flex;
            align-items: center;
            width: 100%;
            min-height: 76px;
            gap: 1.25rem;
            padding: 1.25rem 1.5rem;
            margin: 0;
            box-sizing: border-box;
            border: 2px solid #1677ff;
            border-radius: 10px;
            background: #f4f8ff;
            cursor: pointer;
            transition: all 0.2s ease;
          "
        >
          <span
            style="
              position: relative;
              display: inline-flex;
              flex: 0 0 auto;
              align-items: center;
              justify-content: center;
              width: 24px;
              height: 24px;
            "
          >
            <input
              class="sw-radio-input"
              type="radio"
              name="{{ radio_name }}"
              value=""
              checked
              style="
                position: absolute;
                width: 100%;
                height: 100%;
                margin: 0;
                opacity: 0;
                cursor: pointer;
                z-index: 2;
              "
            >

            <span
              class="sw-radio-custom"
              aria-hidden="true"
              style="
                position: relative;
                display: block;
                width: 22px;
                height: 22px;
                box-sizing: border-box;
                border: 2px solid #1677ff;
                border-radius: 50%;
                background: #ffffff;
              "
            >
              <span
                class="sw-radio-dot"
                style="
                  position: absolute;
                  top: 50%;
                  left: 50%;
                  width: 10px;
                  height: 10px;
                  border-radius: 50%;
                  background: #1677ff;
                  transform: translate(-50%, -50%);
                "
              ></span>
            </span>
          </span>

          <span
            class="sw-option-content"
            style="
              display: flex;
              flex: 1 1 auto;
              align-items: center;
              justify-content: space-between;
              min-width: 0;
              gap: 1.5rem;
            "
          >
            <span
              style="
                min-width: 0;
                color: #111827;
                font-size: 1.6rem;
                font-weight: 650;
                line-height: 1.35;
              "
            >
              One-time Purchase
            </span>

            <span
              style="
                color: #111827;
                font-size: 1.5rem;
                font-weight: 600;
                white-space: nowrap;
              "
            >
              {{ current_variant.price | money }}
            </span>
          </span>
        </label>
      {%- endunless -%}

      {%- for group in product.selling_plan_groups -%}
        {%- for plan in group.selling_plans -%}
          {%- assign plan_allocation = blank -%}

          {%- for allocation in current_variant.selling_plan_allocations -%}
            {%- if allocation.selling_plan.id == plan.id -%}
              {%- assign plan_allocation = allocation -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if plan_allocation != blank -%}
            {%- assign compare_price = plan_allocation.compare_at_price -%}
            {%- assign discount_percentage = 0 -%}

            {%- if compare_price == blank or compare_price == 0 -%}
              {%- assign compare_price = current_variant.price -%}
            {%- endif -%}

            {%- if compare_price > plan_allocation.price -%}
              {%- assign discount_amount = compare_price
                | minus: plan_allocation.price
              -%}

              {%- assign discount_percentage = discount_amount
                | times: 100.0
                | divided_by: compare_price
                | round
              -%}
            {%- endif -%}

            <label
              class="sw-option"
              data-selling-plan-id="{{ plan.id }}"
              data-price="{{ plan_allocation.price | money | escape }}"
              style="
                display: flex;
                align-items: center;
                width: 100%;
                min-height: 76px;
                gap: 1.25rem;
                padding: 1.25rem 1.5rem;
                margin: 0;
                box-sizing: border-box;
                border: 1px solid #d7d9dd;
                border-radius: 10px;
                background: #ffffff;
                cursor: pointer;
                transition: all 0.2s ease;
              "
            >
              <span
                style="
                  position: relative;
                  display: inline-flex;
                  flex: 0 0 auto;
                  align-items: center;
                  justify-content: center;
                  width: 24px;
                  height: 24px;
                "
              >
                <input
                  class="sw-radio-input"
                  type="radio"
                  name="{{ radio_name }}"
                  value="{{ plan.id }}"
                  style="
                    position: absolute;
                    width: 100%;
                    height: 100%;
                    margin: 0;
                    opacity: 0;
                    cursor: pointer;
                    z-index: 2;
                  "
                >

                <span
                  class="sw-radio-custom"
                  aria-hidden="true"
                  style="
                    position: relative;
                    display: block;
                    width: 22px;
                    height: 22px;
                    box-sizing: border-box;
                    border: 2px solid #6b7280;
                    border-radius: 50%;
                    background: #ffffff;
                  "
                ></span>
              </span>

              <span
                class="sw-option-content"
                style="
                  display: flex;
                  flex: 1 1 auto;
                  align-items: center;
                  justify-content: space-between;
                  min-width: 0;
                  gap: 1.5rem;
                "
              >
                <span
                  style="
                    min-width: 0;
                    color: #111827;
                    font-size: 1.6rem;
                    font-weight: 650;
                    line-height: 1.35;
                  "
                >
                  {{ plan.name }}
                </span>

                <span
                  class="sw-option-meta"
                  style="
                    display: flex;
                    flex: 0 0 auto;
                    align-items: center;
                    justify-content: flex-end;
                    gap: 1rem;
                  "
                >
                  <span
                    style="
                      color: #111827;
                      font-size: 1.5rem;
                      font-weight: 600;
                      white-space: nowrap;
                    "
                  >
                    {{ plan_allocation.price | money }}
                  </span>

                  {%- if discount_percentage > 0 -%}
                    <span
                      style="
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        padding: 0.45rem 0.9rem;
                        border-radius: 999px;
                        background: #dcfce7;
                        color: #166534;
                        font-size: 1.3rem;
                        font-weight: 700;
                        line-height: 1.2;
                        white-space: nowrap;
                      "
                    >
                      Save {{ discount_percentage }}%
                    </span>
                  {%- endif -%}
                </span>
              </span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <input
      class="sw-selling-plan-input"
      type="hidden"
      name="selling_plan"
      value=""
    >
  </div>

  <script>
    (() => {
      const widgetId = {{ widget_id | json }};

      function initializeSubscriptionWidget() {
        const widget = document.getElementById(widgetId);

        if (!widget || widget.dataset.initialized === "true") {
          return;
        }

        widget.dataset.initialized = "true";

        const options = Array.from(
          widget.querySelectorAll(".sw-option")
        );

        const sellingPlanInput = widget.querySelector(
          ".sw-selling-plan-input"
        );

        if (!options.length || !sellingPlanInput) {
          return;
        }

        function findProductForm() {
          const configuredFormId = widget.dataset.formId;

          if (configuredFormId) {
            const configuredForm = document.getElementById(
              configuredFormId
            );

            if (configuredForm) {
              return configuredForm;
            }
          }

          const productArea =
            widget.closest("product-info") ||
            widget.closest(".shopify-section") ||
            widget.parentElement;

          if (productArea) {
            const localForm = productArea.querySelector(
              'form[action*="/cart/add"]'
            );

            if (localForm) {
              return localForm;
            }
          }

          return document.querySelector(
            'form[action*="/cart/add"]'
          );
        }

        const productForm = findProductForm();

        if (productForm) {
          const oldSellingPlanInputs = productForm.querySelectorAll(
            'input[name="selling_plan"]'
          );

          oldSellingPlanInputs.forEach((input) => {
            if (input !== sellingPlanInput) {
              input.remove();
            }
          });

          productForm.appendChild(sellingPlanInput);
        } else {
          console.warn(
            "Subscription widget: product form not found."
          );
        }

        function resetOption(option) {
          option.classList.remove("sw-active");
          option.style.border = "1px solid #d7d9dd";
          option.style.background = "#ffffff";
          option.style.boxShadow = "none";

          const radio = option.querySelector(".sw-radio-input");
          const radioCustom = option.querySelector(".sw-radio-custom");
          const radioDot = option.querySelector(".sw-radio-dot");

          if (radio) {
            radio.checked = false;
          }

          if (radioCustom) {
            radioCustom.style.borderColor = "#6b7280";
            radioCustom.style.boxShadow = "none";
          }

          if (radioDot) {
            radioDot.remove();
          }
        }

        function activateOption(option) {
          option.classList.add("sw-active");
          option.style.border = "2px solid #1677ff";
          option.style.background = "#f4f8ff";
          option.style.boxShadow = "0 0 0 1px #1677ff";

          const radio = option.querySelector(".sw-radio-input");
          const radioCustom = option.querySelector(".sw-radio-custom");

          if (radio) {
            radio.checked = true;
          }

          if (radioCustom) {
            radioCustom.style.borderColor = "#1677ff";
            radioCustom.style.boxShadow =
              "0 0 0 3px rgba(22, 119, 255, 0.1)";

            if (!radioCustom.querySelector(".sw-radio-dot")) {
              const dot = document.createElement("span");

              dot.className = "sw-radio-dot";

              dot.style.position = "absolute";
              dot.style.top = "50%";
              dot.style.left = "50%";
              dot.style.width = "10px";
              dot.style.height = "10px";
              dot.style.borderRadius = "50%";
              dot.style.background = "#1677ff";
              dot.style.transform = "translate(-50%, -50%)";

              radioCustom.appendChild(dot);
            }
          }
        }

        function updateMainProductPrice(priceText) {
          if (!priceText) {
            return;
          }

          const productArea =
            widget.closest("product-info") ||
            widget.closest(".shopify-section");

          if (!productArea) {
            return;
          }

          const priceElement =
            productArea.querySelector(".price-item--sale") ||
            productArea.querySelector(".price-item--regular") ||
            productArea.querySelector("[data-product-price]");

          if (priceElement) {
            priceElement.textContent = priceText;
          }
        }

        function selectOption(selectedOption, changePrice = true) {
          options.forEach(resetOption);
          activateOption(selectedOption);

          const sellingPlanId =
            selectedOption.dataset.sellingPlanId || "";

          sellingPlanInput.value = sellingPlanId;

          sellingPlanInput.dispatchEvent(
            new Event("change", {
              bubbles: true
            })
          );

          if (changePrice) {
            updateMainProductPrice(
              selectedOption.dataset.price
            );
          }
        }

        options.forEach((option) => {
          option.addEventListener("click", function () {
            selectOption(option);
          });

          option.addEventListener("mouseenter", function () {
            if (!option.classList.contains("sw-active")) {
              option.style.borderColor = "#9ca3af";
              option.style.boxShadow =
                "0 3px 12px rgba(0, 0, 0, 0.06)";
            }
          });

          option.addEventListener("mouseleave", function () {
            if (!option.classList.contains("sw-active")) {
              option.style.borderColor = "#d7d9dd";
              option.style.boxShadow = "none";
            }
          });

          const radio = option.querySelector(".sw-radio-input");

          if (radio) {
            radio.addEventListener("change", function () {
              if (radio.checked) {
                selectOption(option);
              }
            });
          }
        });

        let selectedOption = options.find((option) => {
          const radio = option.querySelector(".sw-radio-input");
          return radio && radio.checked;
        });

        if (!selectedOption) {
          selectedOption = options[0];
        }

        selectOption(selectedOption, false);
      }

      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          initializeSubscriptionWidget,
          { once: true }
        );
      } else {
        initializeSubscriptionWidget();
      }

      document.addEventListener(
        "shopify:section:load",
        initializeSubscriptionWidget
      );
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Subscription options",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Price Options"
    },
    {
      "type": "text",
      "id": "form_id",
      "label": "Product form ID",
      "info": "Optional. Leave empty to detect the add-to-cart form automatically."
    }
  ]
}
{% endschema %}