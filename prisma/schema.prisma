generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  
  refreshToken  String?
  refreshTokenExpires DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("shopify_sessions")
  @@index([shop])
}

model Shop {
  id                 Int       @id @default(autoincrement())
  shopDomain         String    @unique @map("shop_domain")
  accessToken        String?   @map("access_token")
  scopes             String?
  installationStatus String    @map("installation_status")
  installationDate   DateTime? @map("installation_date")
  uninstallationDate DateTime? @map("uninstallation_date")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  subscriptionRules  SubscriptionRule[]
  sellingPlanGroups  SellingPlanGroup[]
  contracts          SubscriptionContract[]
  webhookEvents      WebhookEvent[]
  backgroundJobs     BackgroundJob[]
  auditLogs          AuditLog[]

  @@map("shops")
  @@index([shopDomain])
}

model SubscriptionRule {
  id                   Int       @id @default(autoincrement())
  shopId               Int       @map("shop_id")
  ruleName             String    @map("rule_name")
  ruleDescription      String?   @db.Text @map("rule_description")
  activeStatus         Boolean   @default(true) @map("active_status")
  minBillingCycles     Int?      @map("min_billing_cycles")
  maxBillingCycles     Int?      @map("max_billing_cycles")
  shopifySellingPlanGroupId String? @map("shopify_selling_plan_group_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  shop                 Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  frequencies          SubscriptionRuleFrequency[]
  products             SubscriptionRuleProduct[]
  variants             SubscriptionRuleVariant[]
  sellingPlanGroups    SellingPlanGroup[]

  @@map("subscription_rules")
  @@index([shopId, activeStatus])
}

enum FrequencyType {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

model SubscriptionRuleFrequency {
  id                   Int       @id @default(autoincrement())
  subscriptionRuleId   Int       @map("subscription_rule_id")
  frequency            FrequencyType
  shopifyInterval      String    @map("shopify_interval")
  intervalCount        Int       @map("interval_count")
  discountType         String?   @map("discount_type")
  discountValue        Decimal?  @db.Decimal(10, 2) @map("discount_value")
  shopifySellingPlanId String?   @map("shopify_selling_plan_id")
  activeStatus         Boolean   @default(true) @map("active_status")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  rule                 SubscriptionRule @relation(fields: [subscriptionRuleId], references: [id], onDelete: Cascade)
  sellingPlans         SellingPlan[]

  @@map("subscription_rule_frequencies")
  @@index([subscriptionRuleId])
}

model SubscriptionRuleProduct {
  id                   Int       @id @default(autoincrement())
  subscriptionRuleId   Int       @map("subscription_rule_id")
  shopifyProductId     String    @map("shopify_product_id")
  productTitle         String    @map("product_title")
  productHandle        String    @map("product_handle")
  productImageUrl      String?   @db.Text @map("product_image_url")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  rule                 SubscriptionRule @relation(fields: [subscriptionRuleId], references: [id], onDelete: Cascade)

  @@map("subscription_rule_products")
  @@unique([subscriptionRuleId, shopifyProductId])
  @@index([shopifyProductId])
}

model SubscriptionRuleVariant {
  id                   Int       @id @default(autoincrement())
  subscriptionRuleId   Int       @map("subscription_rule_id")
  shopifyProductId     String    @map("shopify_product_id")
  shopifyVariantId     String    @map("shopify_variant_id")
  variantTitle         String    @map("variant_title")
  sku                  String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  rule                 SubscriptionRule @relation(fields: [subscriptionRuleId], references: [id], onDelete: Cascade)

  @@map("subscription_rule_variants")
  @@unique([subscriptionRuleId, shopifyVariantId])
  @@index([shopifyVariantId])
}

model SellingPlanGroup {
  id                        Int       @id @default(autoincrement())
  shopId                    Int       @map("shop_id")
  subscriptionRuleId        Int       @map("subscription_rule_id")
  shopifySellingPlanGroupId String    @map("shopify_selling_plan_group_id")
  groupName                 String    @map("group_name")
  merchantCode              String    @map("merchant_code")
  status                    String
  shopifySyncDate           DateTime? @map("shopify_sync_date")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  shop                      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rule                      SubscriptionRule @relation(fields: [subscriptionRuleId], references: [id], onDelete: Cascade)
  sellingPlans              SellingPlan[]

  @@map("selling_plan_groups")
  @@index([shopifySellingPlanGroupId])
  @@index([shopId])
}

model SellingPlan {
  id                          Int       @id @default(autoincrement())
  sellingPlanGroupId          Int       @map("selling_plan_group_id")
  subscriptionRuleFrequencyId Int       @map("subscription_rule_frequency_id")
  shopifySellingPlanId        String    @map("shopify_selling_plan_id")
  planName                    String    @map("plan_name")
  frequency                   FrequencyType
  interval                    String
  intervalCount               Int       @map("interval_count")
  discountType                String?   @map("discount_type")
  discountValue               Decimal?  @db.Decimal(10, 2) @map("discount_value")
  status                      String
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  group                       SellingPlanGroup @relation(fields: [sellingPlanGroupId], references: [id], onDelete: Cascade)
  ruleFrequency               SubscriptionRuleFrequency @relation(fields: [subscriptionRuleFrequencyId], references: [id], onDelete: Cascade)

  @@map("selling_plans")
  @@index([shopifySellingPlanId])
}

model SubscriptionContract {
  id                          Int       @id @default(autoincrement())
  shopId                      Int       @map("shop_id")
  shopifyContractId           String    @map("shopify_contract_id")
  shopifyCustomerId           String    @map("shopify_customer_id")
  customerEmail               String?   @map("customer_email")
  status                      String
  frequency                   FrequencyType
  billingInterval             String    @map("billing_interval")
  billingIntervalCount        Int       @map("billing_interval_count")
  deliveryInterval            String    @map("delivery_interval")
  deliveryIntervalCount       Int       @map("delivery_interval_count")
  nextBillingDate             DateTime? @map("next_billing_date")
  currencyCode                String    @map("currency_code")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  cancelledAt                 DateTime? @map("cancelled_at")

  shop                        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lines                       SubscriptionContractLine[]
  billingAttempts             BillingAttempt[]

  @@map("subscription_contracts")
  @@index([shopifyContractId])
  @@index([shopifyCustomerId])
  @@index([shopId, status])
  @@index([shopId, nextBillingDate])
}

model SubscriptionContractLine {
  id                          Int       @id @default(autoincrement())
  subscriptionContractId      Int       @map("subscription_contract_id")
  shopifyContractLineId       String    @map("shopify_contract_line_id")
  shopifyProductId            String    @map("shopify_product_id")
  shopifyVariantId            String    @map("shopify_variant_id")
  productTitle                String    @map("product_title")
  variantTitle                String    @map("variant_title")
  sku                         String?
  quantity                    Int
  currentPrice                Decimal   @db.Decimal(10, 2) @map("current_price")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  contract                    SubscriptionContract @relation(fields: [subscriptionContractId], references: [id], onDelete: Cascade)

  @@map("subscription_contract_lines")
}

model BillingAttempt {
  id                          Int       @id @default(autoincrement())
  subscriptionContractId      Int       @map("subscription_contract_id")
  shopifyBillingAttemptId     String?   @map("shopify_billing_attempt_id")
  idempotencyKey              String    @unique @map("idempotency_key")
  billingDate                 DateTime  @map("billing_date")
  amount                      Decimal   @db.Decimal(10, 2)
  currencyCode                String    @map("currency_code")
  status                      String
  errorCode                   String?   @map("error_code")
  errorMessage                String?   @db.Text @map("error_message")
  attemptCount                Int       @default(1) @map("attempt_count")
  completedDate               DateTime? @map("completed_date")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  contract                    SubscriptionContract @relation(fields: [subscriptionContractId], references: [id], onDelete: Cascade)

  @@map("billing_attempts")
  @@index([status])
}

model WebhookEvent {
  id                          Int       @id @default(autoincrement())
  shopId                      Int       @map("shop_id")
  shopifyWebhookId            String    @unique @map("shopify_webhook_id")
  webhookTopic                String    @map("webhook_topic")
  payload                     Json
  processingStatus            String    @map("processing_status")
  attemptCount                Int       @default(0) @map("attempt_count")
  errorMessage                String?   @db.Text @map("error_message")
  receivedDate                DateTime  @map("received_date")
  processedDate               DateTime? @map("processed_date")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  shop                        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("webhook_events")
  @@index([shopId, webhookTopic])
  @@index([processingStatus])
}

model BackgroundJob {
  id                          Int       @id @default(autoincrement())
  shopId                      Int       @map("shop_id")
  jobType                     String    @map("job_type")
  payload                     Json
  status                      String
  attemptCount                Int       @default(0) @map("attempt_count")
  maxAttempts                 Int       @default(3) @map("max_attempts")
  availableDate               DateTime  @map("available_date")
  reservedDate                DateTime? @map("reserved_date")
  completedDate               DateTime? @map("completed_date")
  failedDate                  DateTime? @map("failed_date")
  errorMessage                String?   @db.Text @map("error_message")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  shop                        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("background_jobs")
  @@index([status, availableDate])
  @@index([jobType])
}

model AuditLog {
  id                          Int       @id @default(autoincrement())
  shopId                      Int       @map("shop_id")
  userId                      String?   @map("user_id")
  action                      String
  entityType                  String    @map("entity_type")
  entityId                    String    @map("entity_id")
  previousValues              Json?     @map("previous_values")
  newValues                   Json?     @map("new_values")
  ipAddress                   String?   @map("ip_address")
  userAgent                   String?   @map("user_agent")
  createdAt                   DateTime  @default(now()) @map("created_at")

  shop                        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model ShippingSetting {
  id                           Int      @id @default(autoincrement())
  shop                         String   @unique
  isEnabled                    Boolean  @default(true)
  quantityThreshold            Int      @default(5)
  belowThresholdPrice          Decimal  @default(30.00) @db.Decimal(12, 2)
  atOrAboveThresholdPrice      Decimal  @default(5000.00) @db.Decimal(12, 2)
  belowThresholdMethodName     String   @default("Standard Shipping")
  atOrAboveThresholdMethodName String   @default("Bulk Shipping")
  fallbackEnabled              Boolean  @default(false)
  fallbackPrice                Decimal? @db.Decimal(12, 2)
  currency                     String   @default("USD")
  loggingEnabled               Boolean  @default(true)
  debugMode                    Boolean  @default(false)
  carrierServiceId             String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model ShippingRule {
  id                 Int      @id @default(autoincrement())
  shop               String
  ruleName           String
  description        String?
  countryName        String?
  countryCode        String?
  stateName          String?
  stateCode          String?
  city               String?
  postalCode         String?
  postalCodeFrom     String?
  postalCodeTo       String?
  postalCodePattern  String?
  shippingMethodName String
  serviceCode        String
  shippingPrice      Decimal  @db.Decimal(12, 2)
  currency           String   @default("USD")
  priority           Int      @default(0)
  isFreeShipping     Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop])
  @@index([shop, countryCode])
  @@index([shop, countryCode, stateCode])
  @@index([shop, postalCode])
  @@index([shop, priority])
}

model ShippingCalculationLog {
  id                 Int      @id @default(autoincrement())
  shop               String
  countryCode        String?
  stateCode          String?
  city               String?
  postalCode         String?
  cartQuantity       Int
  matchedRuleId      Int?
  matchedRuleName    String?
  calculationSource  String
  calculatedPrice    Decimal  @db.Decimal(12, 2)
  currency           String
  shippingMethodName String
  status             String
  errorMessage       String?
  createdAt          DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

model ProductReview {
  id                 Int          @id @default(autoincrement())
  shop               String
  productId          String
  variantId          String?
  customerId         String?
  customerName       String
  customerEmail      String
  customerPhone      String?
  title              String?
  comment            String       @db.Text
  rating             Int
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  verifiedOrderId    String?
  merchantReply      String?      @db.Text
  helpfulCount       Int          @default(0)
  ipHash             String?
  approvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  images ProductReviewImage[]

  @@index([shop, productId])
  @@index([shop, productId, status])
  @@index([shop, customerId])
  @@index([shop, createdAt])
}

model ProductReviewImage {
  id           Int      @id @default(autoincrement())
  reviewId     Int
  imageUrl     String
  thumbnailUrl String?
  altText      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewSetting {
  id                     Int      @id @default(autoincrement())
  shop                   String   @unique
  isEnabled              Boolean  @default(true)
  allowGuestReviews      Boolean  @default(true)
  guestPhoneRequired     Boolean  @default(false)
  verifiedPurchasesOnly  Boolean  @default(false)
  moderationEnabled      Boolean  @default(true)
  autoApprove            Boolean  @default(false)
  allowMultipleImages    Boolean  @default(true)
  maxImages              Int      @default(5)
  maxImageSizeMb         Int      @default(5)
  reviewsPerPage         Int      @default(9)
  showVerifiedBadge      Boolean  @default(true)
  showRatingDistribution Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
