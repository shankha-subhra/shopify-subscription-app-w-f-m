    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "ngrok": "^5.0.0-beta.2",
